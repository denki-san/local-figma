{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-agent/result.schema.json",
  "title": "规划草案：Figma Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "runId",
    "bindingId",
    "riskLevel",
    "status",
    "startedAt",
    "finishedAt",
    "targetVerified",
    "changedNodeIds",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "bindingId": {
      "type": "string",
      "minLength": 1
    },
    "riskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "rolled-back",
        "needs-review",
        "unknown-after-disconnect"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetVerified": {
      "type": "boolean"
    },
    "changedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "createdNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "hiddenNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deletedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "scriptSaved",
        "structuredResultSaved",
        "targetVerificationSaved",
        "documentReadback",
        "previewGenerated",
        "interactionVerified"
      ],
      "properties": {
        "root": {
          "const": ".figma-agent"
        },
        "scriptSaved": {
          "const": true
        },
        "structuredResultSaved": {
          "const": true
        },
        "targetVerificationSaved": {
          "const": true
        },
        "documentReadback": {
          "type": "boolean"
        },
        "previewGenerated": {
          "type": "boolean"
        },
        "interactionVerified": {
          "type": "boolean"
        },
        "artifactPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "recorded"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "recorded": {
          "type": "boolean"
        },
        "scopeHash": {
          "type": "string"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "verified"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "riskLevel": {
            "const": "high"
          }
        }
      },
      "then": {
        "required": [
          "confirmation"
        ],
        "properties": {
          "confirmation": {
            "properties": {
              "required": {
                "const": true
              },
              "recorded": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
