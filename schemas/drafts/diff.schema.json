{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-agent/diff.schema.json",
  "title": "规划草案：Figma Agent Node Diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "beforeHash",
    "afterHash",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "beforeHash": {
      "type": "string"
    },
    "afterHash": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "nodeId"
        ],
        "properties": {
          "kind": {
            "enum": [
              "created",
              "updated",
              "moved",
              "renamed",
              "hidden",
              "deleted",
              "rebound",
              "prototype-changed"
            ]
          },
          "nodeId": {
            "type": "string"
          },
          "nodeName": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
