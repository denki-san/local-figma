{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "当前 Alpha 目标子树差异",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "executionOk",
    "scope",
    "changes",
    "changedNodeCount",
    "visualReview",
    "interactionReview",
    "limitation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "executionOk": {
      "type": "boolean"
    },
    "scope": {
      "const": "captured-target-subtree"
    },
    "changes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "parentId"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "created"
              },
              "name": {
                "type": "string"
              },
              "parentId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "deleted"
              },
              "name": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "properties"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "updated"
              },
              "properties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "before",
                    "after"
                  ],
                  "properties": {
                    "before": {},
                    "after": {}
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "before",
              "after"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "moved"
              },
              "before": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "parentId",
                  "position"
                ],
                "properties": {
                  "parentId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "parentId",
                  "position"
                ],
                "properties": {
                  "parentId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        ]
      }
    },
    "changedNodeCount": {
      "type": "integer",
      "minimum": 0
    },
    "visualReview": {
      "const": "not-run"
    },
    "interactionReview": {
      "const": "not-run"
    },
    "limitation": {
      "type": "string"
    }
  }
}
