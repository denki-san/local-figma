{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-agent/context.schema.json",
  "title": "Figma Agent Project Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "binding", "project", "pages", "regions", "validation", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceUrl", "fileKey", "pageId", "boundAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?figma\\.com/"
        },
        "fileKey": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "pattern": "^[^:]+:[^:]+$" },
        "nodeId": { "type": "string", "pattern": "^[^:]+:[^:]+$" },
        "boundAt": { "type": "string", "format": "date-time" },
        "verifiedFileName": { "type": "string" },
        "verifiedPageName": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "figmaFileName"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "figmaFileName": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^[^:]+:[^:]+$" },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "editable": { "type": "boolean", "default": true }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/region" }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referencePages": { "type": "array", "items": { "type": "string" } },
        "preferredComponentSets": { "type": "array", "items": { "type": "string" } },
        "preferredVariableCollections": { "type": "array", "items": { "type": "string" } },
        "preferredTextStyles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidDelete": { "type": "boolean", "default": true },
        "forbidCrossPageWrites": { "type": "boolean", "default": true },
        "protectedNodeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": { "$ref": "#/$defs/validationProfile" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "gitIgnored", "saveScript", "saveStructuredResult", "saveTargetVerification", "allowSanitizedCommit"],
      "properties": {
        "root": { "const": ".figma-agent" },
        "gitIgnored": { "const": true },
        "saveScript": { "const": true },
        "saveStructuredResult": { "const": true },
        "saveTargetVerification": { "const": true },
        "allowSanitizedCommit": { "type": "boolean" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "sourceRef", "capturedAt"],
        "properties": {
          "sourceType": { "type": "string" },
          "sourceRef": { "type": "string" },
          "capturedAt": { "type": "string", "format": "date-time" },
          "contentHash": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "name", "semanticRole", "editable"],
      "properties": {
        "nodeId": { "type": "string", "pattern": "^[^:]+:[^:]+$" },
        "name": { "type": "string", "minLength": 1 },
        "semanticRole": {
          "enum": [
            "source-content",
            "summary-view",
            "generated-output",
            "navigation",
            "fixed-action",
            "scroll-viewport",
            "design-system-reference",
            "do-not-edit"
          ]
        },
        "editable": { "type": "boolean" },
        "sourceOfTruth": { "type": "string" },
        "derivedFrom": { "type": "array", "items": { "type": "string" } },
        "summarizes": { "type": "array", "items": { "type": "string" } },
        "mustRemainSiblingOf": { "type": "array", "items": { "type": "string" } },
        "mustRemainOutsideOf": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireMeaningfulNames", "rejectMixedTypography", "rejectOverflow", "rejectOutOfBounds"],
      "properties": {
        "requireMeaningfulNames": { "type": "boolean" },
        "rejectMixedTypography": { "type": "boolean" },
        "rejectOverflow": { "type": "boolean" },
        "rejectOutOfBounds": { "type": "boolean" },
        "allowedOverlaps": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
