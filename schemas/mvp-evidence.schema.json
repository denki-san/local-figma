{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figma-agent/mvp-evidence.schema.json",
  "title": "Figma Agent MVP Public Evidence Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["pending", "passed"] },
    "cases": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "figmaFileFingerprint",
          "bindingId",
          "scenario",
          "runId",
          "scriptPath",
          "resultPath",
          "evidencePaths",
          "targetLocked",
          "noBlindReplay",
          "resultVerified"
        ],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "figmaFileFingerprint": { "type": "string", "minLength": 1 },
          "bindingId": { "type": "string", "minLength": 1 },
          "scenario": { "enum": ["local-text-edit", "complex-layout-edit", "failure-recovery"] },
          "runId": { "type": "string", "minLength": 1 },
          "scriptPath": { "type": "string", "minLength": 1 },
          "resultPath": { "type": "string", "minLength": 1 },
          "evidencePaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "targetLocked": { "const": true },
          "noBlindReplay": { "const": true },
          "resultVerified": { "const": true }
        }
      },
      "allOf": [
        { "contains": { "properties": { "scenario": { "const": "local-text-edit" } }, "required": ["scenario"] } },
        { "contains": { "properties": { "scenario": { "const": "complex-layout-edit" } }, "required": ["scenario"] } },
        { "contains": { "properties": { "scenario": { "const": "failure-recovery" } }, "required": ["scenario"] } }
      ]
    }
  }
}
